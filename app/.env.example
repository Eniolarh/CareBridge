# Copy to .env.local. `deploy.sh` / `deploy.ps1` fills these in automatically.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=

# A funded testnet G-address used only to simulate read-only contract calls.
# The deployer account works well here.
NEXT_PUBLIC_READ_ACCOUNT=

# SAC addresses for the donation tokens. Filled in by the deploy scripts.
NEXT_PUBLIC_XLM_SAC=
NEXT_PUBLIC_USDC_SAC=
NEXT_PUBLIC_DEFAULT_TOKEN=
